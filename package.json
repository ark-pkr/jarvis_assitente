{
  "name": "jarvis",
  "private": true,
  "version": "1.4.1",
  "description": "Assistente pessoal por voz para Windows, em português do Brasil, com interface holográfica.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "node --test \"bridge/*.test.mjs\" \"scripts/*.test.mjs\"",
    "preview": "vite preview",
    "bridge": "node bridge/server.mjs",
    "bridge:writes": "node bridge/server.mjs --writes",
    "setup": "node scripts/setup.mjs",
    "test:gemini": "node bridge/gemini.test.mjs",
    "test:browser": "node bridge/browser.test.mjs",
    "test:ui": "node scripts/check-ui.mjs",
    "test:workspace": "node scripts/check-workspace.mjs",
    "test:projects": "node bridge/projects.test.mjs",
    "test:learning": "node scripts/check-learning.mjs",
    "test:voice": "node bridge/speech.test.mjs && node scripts/check-voice.mjs",
    "test:voice-identity": "node scripts/speaker-identity.test.mjs",
    "test:response-pace": "node scripts/response-pace.test.mjs",
    "test:clarification": "node scripts/clarification.test.mjs",
    "test:desktop": "node bridge/desktop.test.mjs",
    "test:word": "node bridge/word.test.mjs",
    "test:word-live": "node scripts/check-word.mjs",
    "test:lessons": "node bridge/lessons.test.mjs",
    "test:assistant": "node bridge/assistant.test.mjs",
    "test:assistant-ui": "node scripts/check-assistant.mjs",
    "desktop:prepare": "npm run build && node scripts/prepare-desktop.mjs",
    "desktop:start": "node scripts/run-desktop.mjs",
    "desktop:dist": "npm run desktop:prepare && npm install --omit=dev --ignore-scripts --prefix desktop-app && electron-builder --config electron-builder.cjs --win --x64",
    "test:desktop-app": "node bridge/desktop-http.test.mjs",
    "test:electron": "node scripts/check-electron.mjs",
    "test:presence": "node scripts/check-presence.mjs",
    "test:modes": "node scripts/check-modes.mjs",
    "test:studio": "node bridge/studio.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/genai": "^2.32.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "^1.0.13",
    "@picovoice/eagle-web": "^3.0.1",
    "@picovoice/porcupine-web": "^4.0.1",
    "@picovoice/web-voice-processor": "^4.0.10",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "dompurify": "^3.4.12",
    "framer-motion": "^12.43.0",
    "pdfjs-dist": "^6.4.299",
    "playwright-core": "^1.64.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.75.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
